<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %> Details
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 p-6">
    <div class="max-w-2xl mx-auto bg-white shadow-lg rounded-lg p-6">
        <h2 class="text-3xl font-bold text-center mb-4">
            <%= product.name %>
        </h2>
        <p class="text-lg"><strong>Description:</strong>
            <%= product.description %>
        </p>
        <p class="text-lg mt-2"><strong>Sustainability Info:</strong>
            <%= product.sustainabilityInfo %>
        </p>
        <p class="text-lg mt-2"><strong>Average Rating:</strong>
            <%= avgRating %>
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-2">Sustainability Assessment</h3>
        <p class="text-lg"><strong>Score:</strong>
            <%= sustainability.score %> / 100
        </p>
        <p class="text-lg"><strong>Rating:</strong>
            <%= sustainability.rating %>
        </p>

        <h3 class="text-xl font-semibold mt-6 mb-2">Reviews</h3>
        <% if (reviews.length===0) { %>
            <p class="text-gray-600">No reviews yet.</p>
            <% } else { %>
                <ul class="list-disc pl-6 space-y-2">
                    <% reviews.forEach(function(review) { %>
                        <li>
                            <strong>
                                <%= review.username %>:
                            </strong>
                            <%= review.comment %> (Rating: <%= review.rating %>)
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <h3 class="text-xl font-semibold mt-6 mb-2">Add a Review</h3>
                    <form action="/product/<%= product.id %>/review" method="post" class="space-y-4">
                        <textarea name="comment" placeholder="Your review" required
                            class="w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"></textarea>
                        <label class="block text-sm font-medium">Rating:</label>
                        <select name="rating"
                            class="w-full p-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                        <button type="submit"
                            class="w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 transition">Submit
                            Review</button>
                    </form>
                    <form action="/go-back" method="GET" class="mt-4">
                        <button type="submit"
                            class="w-full bg-gray-500 text-white py-2 rounded-lg hover:bg-gray-600 transition">Back</button>
                    </form>
    </div>
</body>

</html>